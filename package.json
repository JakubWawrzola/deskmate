{
  "name": "deskmate",
  "private": true,
  "version": "0.9.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:streamdeck": "npm --prefix streamdeck-plugin ci && npm --prefix streamdeck-plugin run build",
    "build:service": "node scripts/build-service.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci src vite.config.ts && node scripts/check-i18n.mjs",
    "format": "biome check --write --linter-enabled=false src vite.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}

{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Deskmate for Home Assistant",
	"Version": "0.2.0.0",
	"Author": "Jakub Wawrzola",
	"Description": "Control Home Assistant from Stream Deck, through the Deskmate app or directly: toggle entities with live state, call any service, activate scenes, and run the actions you defined in Deskmate.",
	"Category": "Deskmate",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24"
	},
	"UUID": "com.deskmate.streamdeck",
	"Actions": [
		{
			"Name": "Toggle Entity",
			"UUID": "com.deskmate.streamdeck.toggle",
			"Icon": "imgs/actions/toggle/icon",
			"Tooltip": "Toggle a Home Assistant entity. The key shows its live on/off state.",
			"PropertyInspectorPath": "ui/toggle-entity.html",
			"Controllers": ["Keypad"],
			"DisableAutomaticStates": true,
			"States": [
				{
					"Image": "imgs/actions/toggle/off",
					"TitleAlignment": "bottom"
				},
				{
					"Image": "imgs/actions/toggle/on",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Call Service",
			"UUID": "com.deskmate.streamdeck.call-service",
			"Icon": "imgs/actions/service/icon",
			"Tooltip": "Call any Home Assistant service with optional entity and JSON data.",
			"PropertyInspectorPath": "ui/call-service.html",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/service/key",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Activate Scene",
			"UUID": "com.deskmate.streamdeck.scene",
			"Icon": "imgs/actions/scene/icon",
			"Tooltip": "Activate a Home Assistant scene.",
			"PropertyInspectorPath": "ui/activate-scene.html",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/scene/key",
					"TitleAlignment": "bottom"
				}
			]
		},
		{
			"Name": "Deskmate Action",
			"UUID": "com.deskmate.streamdeck.action",
			"Icon": "imgs/actions/deskmate/icon",
			"Tooltip": "Run an action you defined in Deskmate: a hotkey or a tray quick action.",
			"PropertyInspectorPath": "ui/deskmate-action.html",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/deskmate/key",
					"TitleAlignment": "bottom"
				}
			]
		}
	]
}

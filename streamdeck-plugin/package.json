{
	"name": "deskmate-streamdeck",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"description": "Stream Deck plugin for Deskmate: controls Home Assistant from Stream Deck keys",
	"scripts": {
		"build": "rollup -c && node scripts/check-bundle.mjs",
		"watch": "rollup -c -w",
		"icons": "node scripts/generate-icons.mjs",
		"lint": "biome ci",
		"format": "biome check --write --linter-enabled=false"
	},
	"dependencies": {
		"@elgato/streamdeck": "^3.0.4",
		"ws": "^8.22.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.0",
		"@rollup/plugin-typescript": "^12.3.1",
		"@tsconfig/node24": "^24.0.5",
		"@types/node": "^24.19.2",
		"@types/ws": "^8.18.2",
		"rollup": "^4.68.0",
		"tslib": "^2.9.1",
		"typescript": "^5.6.3"
	},
	"overrides": {
		"zod": "^4.6.6"
	}
}

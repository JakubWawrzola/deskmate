{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deskmate",
  "version": "0.6.0",
  "identifier": "com.deskmate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Deskmate",
        "width": 1060,
        "height": 700,
        "minWidth": 820,
        "minHeight": 560
      },
      {
        "label": "widget",
        "title": "Deskmate widgets",
        "url": "index.html#widget",
        "width": 260,
        "height": 340,
        "minWidth": 200,
        "minHeight": 160,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}

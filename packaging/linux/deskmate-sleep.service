# Tells the Deskmate daemon that the computer is about to sleep, and that it
# woke up. sleep.target starts this unit before a suspend or hibernation and,
# because nothing needs it any more, stops it again after the wake-up.
#
# The daemon then says goodbye to Home Assistant (SIGUSR1) and connects again
# at once after the wake-up (SIGUSR2). Without this unit it notices the
# wake-up a few seconds later on its own.
#
# sleep.target comes late. logind first lets the programs that hold a delay
# lock prepare, and NetworkManager is one of them: it takes the network down
# before this unit starts. Where it does, the goodbye does not reach Home
# Assistant, which then shows the computer as Disconnected, not Sleeping.
[Unit]
Description=Tell the Deskmate daemon about sleep
Before=sleep.target
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
# "-": a daemon that is not running must not keep the computer awake.
ExecStart=-systemctl kill --signal=SIGUSR1 --kill-who=main deskmate.service
# Time for the goodbye before the system sleeps.
ExecStart=sleep 1.5
ExecStop=-systemctl kill --signal=SIGUSR2 --kill-who=main deskmate.service

[Install]
WantedBy=sleep.target

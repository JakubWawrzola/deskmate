#!/bin/sh
# Stops and disables the daemon before its files go. An upgrade keeps it
# enabled; postinst restarts it.
set -e

if [ "$1" = "remove" ]; then
    if [ -d /run/systemd/system ]; then
        systemctl stop deskmate.service || true
    fi
    systemctl disable deskmate.service deskmate-sleep.service >/dev/null 2>&1 || true
fi
